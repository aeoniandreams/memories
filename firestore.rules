rules_version = "2";

// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 그대로 붙여넣고 게시(Publish)하세요.
// 로그인한 사용자는 모두 백업을 볼 수 있고, 그중 관리자 이메일 계정만 카드 본문(messages 등)을
// 생성/수정/삭제할 수 있습니다. 트윗별 코멘트(tweetComments)는 별도 규칙으로, 관리자가 아닌
// 로그인 사용자도 자신의 코멘트(user 필드)만 쓸 수 있고, 관리자는 자신의 코멘트(admin 필드)만
// 쓸 수 있습니다 — 서로 다른 사람의 코멘트 필드나 카드 본문은 건드릴 수 없습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    // ⬇️ 관리자 이메일 입력란: 이 이메일 계정만 카드 본문을 생성/수정/삭제할 수 있고,
    // 트윗 코멘트의 admin 필드도 이 계정만 쓸 수 있습니다.
    // 나중에 이 값을 바꾸면, js/app.js 상단의 ADMIN_EMAIL도 반드시 똑같이 바꿔주세요.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "ae0niandreams@gmail.com";
    }

    match /cards/{cardId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /tweetComments/{messageId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null && (
          (isAdmin() && request.resource.data.keys().hasOnly(["admin", "updatedAt"]))
          ||
          (!isAdmin() && request.resource.data.keys().hasOnly(["user", "updatedAt"]))
        );

        allow update: if request.auth != null && (
          (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["admin", "updatedAt"]))
          ||
          (!isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["user", "updatedAt"]))
        );
      }
    }

    // SumOne. X/카카오톡과 완전히 분리된 컬렉션이고, 권한 규칙은 카드
    // 본문과 동일합니다(로그인하면 보기 가능, 관리자만 쓰기 가능). 카드
    // 하나에 코멘트 대상(이미지+내용)이 하나뿐이라, sumoneComments 서브
    // 컬렉션엔 고정된 문서 하나("main")만 씁니다.
    match /sumoneCards/{cardId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /sumoneComments/{docId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null && (
          (isAdmin() && request.resource.data.keys().hasOnly(["admin", "updatedAt"]))
          ||
          (!isAdmin() && request.resource.data.keys().hasOnly(["user", "updatedAt"]))
        );

        allow update: if request.auth != null && (
          (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["admin", "updatedAt"]))
          ||
          (!isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["user", "updatedAt"]))
        );
      }
    }

    // 카카오톡 백업. X 백업(cards)과 완전히 분리된 컬렉션이고, 권한 규칙은
    // 카드 본문과 동일합니다(로그인하면 보기 가능, 관리자만 쓰기 가능).
    match /kakaoCards/{cardId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      // 메시지별 코멘트. cards/tweetComments와 완전히 같은 규칙입니다 —
      // 관리자가 아닌 로그인 사용자도 자신의 코멘트(user 필드)만 쓸 수 있고,
      // 관리자는 자신의 코멘트(admin 필드)만 쓸 수 있습니다.
      match /kakaoComments/{messageKey} {
        allow read: if request.auth != null;

        allow create: if request.auth != null && (
          (isAdmin() && request.resource.data.keys().hasOnly(["admin", "updatedAt"]))
          ||
          (!isAdmin() && request.resource.data.keys().hasOnly(["user", "updatedAt"]))
        );

        allow update: if request.auth != null && (
          (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["admin", "updatedAt"]))
          ||
          (!isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["user", "updatedAt"]))
        );
      }
    }

    // 앱 설명(사이드바 하단 물음표 아이콘). 로그인한 사람은 누구나 볼 수
    // 있고, 관리자만 고칠 수 있습니다. 문서 하나("main")만 씁니다.
    match /appInfo/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 알림 "읽음" 표시. 사용자마다 완전히 따로 저장되고(본인 것만 읽고
    // 쓸 수 있음), 다른 사람이 남긴 코멘트를 내가 확인했는지 여부만
    // 담습니다 — 카드 본문이나 코멘트 자체와는 무관합니다.
    // cardMarks: 홈 화면 카드의 새 코멘트 점(뱃지)이 사라지는 기준.
    // targetMarks: 코멘트 하나(트윗/카톡 메시지/SumOne 카드)의 보기
    // 버튼 강조색과 알림창 목록이 사라지는 기준.
    match /notifSeen/{uid} {
      match /cardMarks/{markId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /targetMarks/{markId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
