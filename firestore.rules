rules_version = "2";

// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 그대로 붙여넣고 게시(Publish)하세요.
// 로그인한 사용자는 모두 백업을 볼 수 있고, 그중 관리자 이메일 계정만 생성/수정/삭제할 수 있습니다.
//
// ⬇️ 관리자 이메일 입력란: 이 이메일 계정만 백업을 생성/수정/삭제할 수 있습니다.
// 나중에 이 값을 바꾸면, js/app.js 상단의 ADMIN_EMAIL도 반드시 똑같이 바꿔주세요.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cards/{cardId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == "ae0niandreams@gmail.com"; // 관리자 이메일 입력란
    }
  }
}
