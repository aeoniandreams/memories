rules_version = "2";

// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 그대로 붙여넣고 게시(Publish)하세요.
// 로그인한 사용자(직접 만들어 둔 계정)만 카드를 읽고 쓸 수 있도록 제한합니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /cards/{cardId} {
      allow read, write: if request.auth != null;
    }
  }
}
