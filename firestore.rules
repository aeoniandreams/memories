rules_version = "2";

// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 그대로 붙여넣고 게시(Publish)하세요.
// 로그인한 사용자는 모두 백업을 볼 수 있고, 그중 관리자 이메일 계정만 카드 본문(messages 등)을
// 생성/수정/삭제할 수 있습니다. 트윗별 코멘트(tweetComments)는 별도 규칙으로, 관리자가 아닌
// 로그인 사용자도 자신의 코멘트(user 필드)만 쓸 수 있고, 관리자는 자신의 코멘트(admin 필드)만
// 쓸 수 있습니다 — 서로 다른 사람의 코멘트 필드나 카드 본문은 건드릴 수 없습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    // ⬇️ 관리자 이메일 입력란: 이 이메일 계정만 카드 본문을 생성/수정/삭제할 수 있고,
    // 트윗 코멘트의 admin 필드도 이 계정만 쓸 수 있습니다.
    // 나중에 이 값을 바꾸면, js/app.js 상단의 ADMIN_EMAIL도 반드시 똑같이 바꿔주세요.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "ae0niandreams@gmail.com";
    }

    match /cards/{cardId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /tweetComments/{messageId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null && (
          (isAdmin() && request.resource.data.keys().hasOnly(["admin", "updatedAt"]))
          ||
          (!isAdmin() && request.resource.data.keys().hasOnly(["user", "updatedAt"]))
        );

        allow update: if request.auth != null && (
          (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["admin", "updatedAt"]))
          ||
          (!isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["user", "updatedAt"]))
        );
      }
    }
  }
}
